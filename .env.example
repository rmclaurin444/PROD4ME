# PROD4ME environment variables. Copy to .env for local development.
# On Railway, set these on the web service's Variables tab (see DEPLOY.md).
# In production the server refuses to start if a REQUIRED variable is
# missing, and lists every missing one (lib/env.ts).

# ─── Core (REQUIRED) ──────────────────────────────────────────────────────────

# Postgres with the pgvector extension. Local: the `postgres` service in
# docker-compose.yml. Railway: ${{ pgvector.DATABASE_URL }} (private network).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prod4me"

# Auth.js session signing secret. Generate one with: openssl rand -base64 32
# (Windows: run the same command in Git Bash, or use `pnpm exec auth secret`)
AUTH_SECRET=""

# Trust the X-Forwarded-Host header from Railway's proxy (Auth.js only does
# this automatically on Vercel/Cloudflare). Required in production.
AUTH_TRUST_HOST=true

# Public base URL of the app, no trailing slash. Used for every link in
# emails, Stripe redirect URLs, /api/media image URLs and page metadata.
# Production falls back to https://${RAILWAY_PUBLIC_DOMAIN} (set by Railway
# automatically); development falls back to http://localhost:3000.
# APP_URL=https://prod4me.studio

# Protects the cron routes (/api/cron/*): callers must send
# `Authorization: Bearer ${CRON_SECRET}`. Generate: openssl rand -hex 32
# CRON_SECRET="any-long-random-string"

# Admins — comma-separated emails allowed into the /dev panel (case-insensitive,
# whitespace-trimmed). Admins see the Analytics area in every environment; the
# dev tools additionally require dev mode (NODE_ENV !== "production" or
# DEV_PANEL=1). Required in production.
# ADMIN_EMAILS=you@example.com

# ─── Storage (REQUIRED) — S3-compatible: local MinIO or Railway Buckets ───────

# Host of the S3 API (a bare host, or a URL — the scheme is stripped).
MINIO_ENDPOINT=localhost
# Optional — 9000 for local MinIO, 443 on Railway.
MINIO_PORT=9000
# Optional — true on Railway (HTTPS), false for local MinIO.
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Private bucket for beat audio (served only through presigned URLs).
MINIO_BUCKET_AUDIO=beat-audio
# Bucket for artwork, avatars, banners and playlist covers.
MINIO_BUCKET_ARTWORK=beat-artwork

# Optional — bucket region (default us-east-1). Railway: the bucket's REGION.
# MINIO_REGION=us-east-1

# Optional — "true" (default) uses path-style URLs (host/bucket/key) as local
# MinIO needs; Railway Buckets need virtual-hosted style: MINIO_PATH_STYLE=false
# MINIO_PATH_STYLE=true

# Optional — "1" serves images through GET /api/media/<key>, which redirects
# to a short-lived presigned URL. Required on Railway, where buckets are
# private (no public URLs). Leave unset locally (the MinIO artwork bucket is
# public-read).
# MEDIA_PROXY=1

# Optional, legacy — public host for a public-read bucket (bucket name goes in
# the URL path). NOT used on Railway (use MEDIA_PROXY=1 instead).
# MINIO_PUBLIC_ENDPOINT=

# ─── Email (REQUIRED in production) — Resend ──────────────────────────────────

# Without a key in development, emails are printed to the console instead.
# In production a missing key stops the server at startup.
# RESEND_API_KEY=re_...
# Sender address on a domain verified in Resend.
# EMAIL_FROM="PROD4ME <no-reply@prod4me.studio>"

# ─── Email address check (optional) — self-hosted Rapid Email Verifier ────────

# Our own private validator container (umutert/emailvalidator, pinned by
# digest). Checks syntax, domain/MX and throwaway domains at signup and email
# change, and suggests typo fixes. Fails open: if it's down or slow (3s), the
# check is skipped and signup still works. Unset or "off" skips the check.
# The public hosted API is never used.
#   Local (docker compose up -d email-validator): http://localhost:8080
#   Railway (private network, no public domain):  http://email-validator.railway.internal:8080
# EMAIL_CHECK_URL=http://localhost:8080

# ─── Payments (optional) — Stripe test mode ───────────────────────────────────

# Without it, paid checkout is disabled but the rest of the app works.
# While the key starts with sk_test_, the purchase screens show a test-mode
# notice with the 4242 test card.
# STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the webhook endpoint ({APP_URL}/api/webhooks/stripe).
# The Stripe CLI's local secret is different from the dashboard endpoint's.
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Phone verification (optional) — Twilio Verify ────────────────────────────

# Without these in development, codes print to the console. In production
# without them, phone features are hidden.
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_VERIFY_SERVICE_SID=VA...

# ─── Feature flags (optional) ─────────────────────────────────────────────────

# Forces the dev panel's tool area on in production (admins only).
# DEV_PANEL=1

# Enables the full Studio workspace at /studio (default off: the route shows a
# "Studio is coming soon" screen). Inlined at build time, so set it before
# `next build` in production.
# NEXT_PUBLIC_STUDIO_ENABLED=1

# ─── Set automatically by Railway (do not set by hand) ────────────────────────
# PORT                   — the port `next start` listens on
# RAILWAY_PUBLIC_DOMAIN  — the service's public domain (APP_URL fallback)
