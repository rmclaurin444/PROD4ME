generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  PRODUCER
  ARTIST
}

enum LicenseType {
  NON_EXCLUSIVE
  EXCLUSIVE
}

enum OfferStatus {
  PENDING
  COUNTERED
  DECLINED
  AWAITING_PAYMENT
  PAID
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum TagType {
  GENRE
  STYLE
}

enum EngagementEventType {
  PLAY_50
  PLAY_COMPLETE
  TAG_TAP
  LIKE
  SAVE
  FOLLOW_PRODUCER
  OFFER
  BUY
  COMMENT
  SKIP
  SHARE
  STREAM
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  bio       String?
  avatar    String?
  banner    String?
  theme     String?  @default("acid")
  resetTokenHash     String?
  resetTokenExpiresAt DateTime?
  username           String   @unique
  phone              String?  @unique
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  passwordChangedAt  DateTime?
  pendingEmail       String?
  notificationsSeenAt DateTime?

  verificationTokens VerificationToken[]
  interests  Tag[] @relation("UserInterests")
  events     EngagementEvent[]

  conversations        ConversationParticipant[]
  messagesSent         Message[]
  blocksSent           Block[] @relation("Blocker")
  blocksReceived       Block[] @relation("Blocked")
  feedRefreshes        FeedRefresh[]
  following            Follow[] @relation("Following")
  followers            Follow[] @relation("Followers")
  followingFeedSeenAt  DateTime?

  tasteVector Unsupported("vector(256)")?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  beats     Beat[]
  playlists Playlist[]
  leaderboardEntries LeaderboardSnapshot[]
  offersMade Offer[] @relation("ArtistOffers")
  offersReceived Offer[] @relation("ProducerOffers")
  payments  Payment[]
  licenses  License[]
}

model Beat {
  id          String   @id @default(cuid())
  title       String
  bpm         Int?
  musicalKey  String?
  price       Int      @default(0)
  audioKey    String
  artKey      String?
  artUrl      String?
  artPreset   String?
  peaks       Json?
  durationSec Int?
  streams     Int      @default(0)
  likes       Int      @default(0)
  saves       Int      @default(0)
  shares      Int      @default(0)
  comments    Int      @default(0)
  producerId  String
  producer    User     @relation(fields: [producerId], references: [id], onDelete: Cascade)
  tags        Tag[]

  exclusivePriceCents Int?  @map("exclusivePriceCents")
  exclusiveSold       Boolean @default(false) @map("exclusiveSold")
  playlistId          String?
  playlist            Playlist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)
  playlistPosition    Int?
  offers     Offer[]
  licenses   License[]
  payments   Payment[]
  events     EngagementEvent[]
  messages   Message[]
  leaderboardEntries LeaderboardSnapshot[]

  tagVector  Unsupported("vector(256)")?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt


  @@index([producerId])
  @@index([createdAt])
}

model Playlist {
  id          String   @id @default(cuid())
  producerId  String
  producer    User     @relation(fields: [producerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  artKey      String?
  artPreset   String?
  beats       Beat[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([producerId])
}

model LeaderboardSnapshot {
  id         String   @id @default(cuid())
  weekStart  DateTime
  kind       String
  rank       Int
  beatId     String?
  beat       Beat?    @relation(fields: [beatId], references: [id], onDelete: SetNull)
  producerId String?
  producer   User?    @relation(fields: [producerId], references: [id], onDelete: SetNull)
  score      Float
  breakdown  Json
  createdAt  DateTime @default(now())

  @@unique([weekStart, kind, rank])
  @@index([weekStart, kind])
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  tokenHash String    @unique
  target    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, kind])
}

model Tag {
  id            String  @id @default(cuid())
  name          String  @unique
  slug          String  @unique
  type          TagType @default(GENRE)
  useCount      Int     @default(0)
  interestCount Int     @default(0)
  vectorIndex   Int?    @unique
  beats         Beat[]
  interestedUsers User[] @relation("UserInterests")
}

model EngagementEvent {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  beatId    String
  beat      Beat                @relation(fields: [beatId], references: [id], onDelete: Cascade)
  type      EngagementEventType
  metadata  Json?
  createdAt DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([beatId])
}

model Offer {
  id                String      @id @default(cuid())
  beatId            String
  beat              Beat        @relation(fields: [beatId], references: [id], onDelete: Cascade)
  artistId          String
  artist            User        @relation("ArtistOffers", fields: [artistId], references: [id], onDelete: Cascade)
  producerId        String
  producer          User        @relation("ProducerOffers", fields: [producerId], references: [id], onDelete: Cascade)
  licenseType       LicenseType
  listingPriceCents Int
  amountCents       Int
  counterAmountCents Int?
  agreedAmountCents Int?
  message           String?
  counterMessage    String?
  status            OfferStatus @default(PENDING)
  expiresAt         DateTime?
  payment           Payment?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([producerId, status])
  @@index([artistId])
  @@index([status, expiresAt])
}

model Payment {
  id                    String        @id @default(cuid())
  stripeSessionId       String        @unique
  stripePaymentIntentId String?
  amountCents           Int
  status                PaymentStatus @default(PENDING)
  beatId                String
  beat                  Beat          @relation(fields: [beatId], references: [id], onDelete: Cascade)
  artistId              String
  artist                User          @relation(fields: [artistId], references: [id], onDelete: Cascade)
  licenseType           LicenseType
  offerId               String?       @unique
  offer                 Offer?        @relation(fields: [offerId], references: [id])
  license               License?
  createdAt             DateTime      @default(now())
}

model License {
  id              String      @id @default(cuid())
  beatId          String
  beat            Beat        @relation(fields: [beatId], references: [id], onDelete: Cascade)
  artistId        String
  artist          User        @relation(fields: [artistId], references: [id], onDelete: Cascade)
  licenseType     LicenseType
  pricePaidCents  Int
  paymentId       String?     @unique
  payment         Payment?    @relation(fields: [paymentId], references: [id])
  offerId         String?     @unique
  createdAt       DateTime    @default(now())

  @@unique([beatId, artistId, licenseType])
  @@index([artistId])
}

model Conversation {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  hiddenAt       DateTime?

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  beatId         String?
  beat           Beat?       @relation(fields: [beatId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())

  @@index([conversationId, createdAt])
}

model FeedRefresh {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Follow {
  followerId  String
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@id([followerId, followingId])
  @@index([followingId, createdAt])
}

model Block {
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}
