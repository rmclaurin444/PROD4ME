# Postgres — matches the `postgres` service in docker-compose.yml
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/prod4me"

# Auth.js session signing secret. Generate one with: openssl rand -base64 32
# (Windows: run the same command in Git Bash, or use `pnpm exec auth secret`)
AUTH_SECRET=""

# MinIO — defaults shown match docker-compose.yml
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_AUDIO=beat-audio
MINIO_BUCKET_ARTWORK=beat-artwork

# Optional — Stripe checkout (test mode keys from the Stripe dashboard).
# Without it, paid checkout is disabled but the rest of the app works.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional — production only: public host that serves public-read objects
# (artwork) when the S3 API endpoint isn't itself publicly readable.
# Cloudflare R2 example: "pub-<hash>.r2.dev". Leave unset for local MinIO.
# MINIO_PUBLIC_ENDPOINT=

# Admins — comma-separated emails allowed into the /dev panel (case-insensitive,
# whitespace-trimmed). Admins see the Analytics area in every environment; the
# dev tools additionally require dev mode (NODE_ENV !== "production" or
# DEV_PANEL=1). Leave unset for no admins.
# ADMIN_EMAILS=you@example.com

# Optional — forces the dev panel's tool area on in production (admins only).
# DEV_PANEL=1

# Optional — enables the full Studio workspace at /studio (default off: the
# route shows a "Studio is coming soon" screen). Inlined at build time, so set
# it before `next build` in production.
# NEXT_PUBLIC_STUDIO_ENABLED=1

# Cron protection — the weekly leaderboard snapshot and offer-expiry jobs
# require `Authorization: Bearer ${CRON_SECRET}` (see vercel.json crons).
# CRON_SECRET="any-long-random-string"
